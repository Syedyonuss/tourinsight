{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "web",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE-WITH-YOUR-RENDER-SERVICE.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://REPLACE-WITH-YOUR-RENDER-SERVICE.onrender.com/uploads/:path*"
    },
    {
      "source": "/shared/:path*",
      "destination": "https://REPLACE-WITH-YOUR-RENDER-SERVICE.onrender.com/shared/:path*"
    }
  ]
}
